# Configuración de entorno — Planificador de Observación y Calidad del Cielo
# Copia este archivo a .env.local para desarrollo local. Nunca commitees .env o .env.local.

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Nivel de logs JSON: debug | info | warn | error
LOG_LEVEL=info

# URL base de Open-Meteo (sin barra final)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Timeout en milisegundos para peticiones a APIs externas
EXTERNAL_API_TIMEOUT_MS=5000

# --- Fase 5 (Autenticación y Base de Datos) ---
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# AUTH_SECRET=replace-with-32-char-random-secret
