{
  "name": "planificador-observacion-cielo",
  "version": "0.1.0",
  "private": true,
  "description": "Planificador de observación astronómica y calidad del cielo para la Región de Coquimbo y observatorios de Chile.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
